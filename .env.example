# Ollama local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-m3:latest
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_AGENT_MODEL=qwen3.5:9b
OLLAMA_AGENT_REASONING=false
OLLAMA_AGENT_NUM_PREDICT=700
OLLAMA_AGENT_TIMEOUT=180

# Qdrant : laisser QDRANT_URL vide pour utiliser data/qdrant en mode local.
QDRANT_URL=
QDRANT_API_KEY=

# Recherche et ingestion
CLIP_MODEL=openai/clip-vit-base-patch32
TEXT_TOP_K=5
IMAGE_TOP_K=4
CHUNK_SIZE=800
CHUNK_OVERLAP=120
ENABLE_VLM_CAPTIONS=false
MAX_IMAGES_PER_DOCUMENT=40

